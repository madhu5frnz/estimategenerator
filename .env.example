# Copy to .env for local development. Never commit real secrets.
# Full reference: docs/design/09-environment-variables.md

APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

APP_BASE_URL=http://localhost:3000

# Required outside development/test (32+ random characters each), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SIGNING_KEY=

DATABASE_URL=postgresql+psycopg://estimateai:estimateai@localhost:5432/estimateai
REDIS_URL=redis://localhost:6379/0

# Email: "console" writes emails and their links to the API log (no email service needed).
EMAIL_PROVIDER=console
# EMAIL_FROM=EstimateAI <no-reply@example.com>
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=

# Google sign-in is hidden unless all three are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# AI is optional. Leave ANTHROPIC_API_KEY empty to use the rules-based extractor.
# AI_PROVIDER=rules          # rules | mock | anthropic (default: anthropic if a key is set)
ANTHROPIC_API_KEY=

# Frontend (server-side only): where Next.js proxies /api/*
BACKEND_URL=http://localhost:8000
